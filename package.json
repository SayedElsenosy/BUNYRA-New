  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:identity": "node scripts/prepare-identity-tests.mjs && node scripts/run-identity-tests.mjs",
