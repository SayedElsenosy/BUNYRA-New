    "@neondatabase/serverless": "^1.0.2",
    "@opennextjs/cloudflare": "1.20.12",
    "@shadcn/react": "^0.3.0",
    "@smithy/fetch-http-handler": "^5.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
