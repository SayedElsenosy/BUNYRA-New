    "test:platform": "node scripts/prepare-identity-tests.mjs && node scripts/run-platform-tests.mjs",
    "test:companies": "node scripts/prepare-identity-tests.mjs && node scripts/run-company-tests.mjs",
    "test:db": "npm run -s test:tenancy && npm run -s test:platform && npm run -s test:companies && npm run -s test:identity && npm run -s test:organization && npm run -s test:projects && npm run -s test:inventory && npm run -s test:inventory-sync && npm run -s test:accounts && npm run -s test:pricing && npm run -s test:plan-revisions && npm run -s test:crm && npm run -s test:sales && npm run -s test:finance && npm run -s test:commercial-integrity && npm run -s test:commissions-reports && npm run -s test:workspace && npm run -s test:customer-journey && npm run -s test:saved-offers && npm run -s test:pipeline && npm run -s test:lead-routing && npm run -s test:follow-ups",
    "test:inventory-sync": "node scripts/prepare-identity-tests.mjs && node scripts/test-inventory-sync.mjs",
    "test:accounts": "node scripts/prepare-identity-tests.mjs && node scripts/run-account-tests.mjs",
    "test:pricing": "node scripts/prepare-identity-tests.mjs && node scripts/run-pricing-tests.mjs",
    "test:plan-revisions": "node scripts/prepare-identity-tests.mjs && node scripts/run-plan-revision-tests.mjs",
    "test:crm": "node scripts/prepare-identity-tests.mjs && node scripts/run-crm-tests.mjs",
    "test:sales": "node scripts/prepare-identity-tests.mjs && node scripts/run-sales-tests.mjs",
    "test:finance": "node scripts/prepare-identity-tests.mjs && node scripts/run-finance-tests.mjs",
    "test:commercial-integrity": "node scripts/prepare-identity-tests.mjs && node scripts/run-commercial-integrity-tests.mjs",
    "test:commissions-reports": "node scripts/prepare-identity-tests.mjs && node scripts/run-commissions-reports-tests.mjs",
    "test:navigation": "node scripts/test-workspace-navigation.mjs",
    "test:workspace": "node scripts/prepare-identity-tests.mjs && node scripts/run-workspace-hub-tests.mjs",
    "test:customer-journey": "node scripts/prepare-identity-tests.mjs && node scripts/run-customer-journey-tests.mjs",
    "test:saved-offers": "node scripts/prepare-identity-tests.mjs && node scripts/run-saved-offers-tests.mjs",
    "test:pipeline": "node scripts/prepare-identity-tests.mjs && node scripts/run-pipeline-tests.mjs",
    "test:lead-routing": "node scripts/prepare-identity-tests.mjs && node scripts/run-lead-routing-tests.mjs",
    "test:report-dates": "node scripts/test-report-dates.mjs",
    "test:report-csv": "node scripts/test-report-csv.mjs",
    "test:workspace-alerts": "npm run -s test:workspace",
    "test:follow-ups": "node scripts/prepare-identity-tests.mjs && node scripts/run-follow-up-workflow-tests.mjs",
    "test:feature-gates": "node scripts/test-feature-gates.mjs"
